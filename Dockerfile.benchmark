FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Minimal system deps (libgl1 + libglib2 for opencv, pkg-config + libssl-dev for Rust)
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv gcc curl xz-utils bc unzip git \
    pkg-config libssl-dev \
    libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

# Venv
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# PyTorch 2.10 + CUDA 12.8 (latest as of 2026-03)
RUN pip install --no-cache-dir \
    torch==2.10.0+cu128 torchvision==0.25.0+cu128 \
    --index-url https://download.pytorch.org/whl/cu128

# Real-ESRGAN + deps
RUN pip install --no-cache-dir \
    realesrgan "numpy==1.26.4" "basicsr==1.4.2" \
    yt-dlp google-api-python-client google-auth-oauthlib && \
    pip uninstall -y opencv-python opencv-contrib-python 2>/dev/null; \
    pip install --no-cache-dir "opencv-python-headless==4.10.0.84" && \
    pip install --no-cache-dir "numpy==1.26.4"

# Patch basicsr for newer torchvision (may already be patched in newer versions)
RUN DEGRADATIONS_FILE=$(python3 -c "import importlib.util; spec=importlib.util.find_spec('basicsr'); print(spec.submodule_search_locations[0] if spec else '/dev/null')")/data/degradations.py && \
    if [ -f "$DEGRADATIONS_FILE" ] && grep -q "functional_tensor" "$DEGRADATIONS_FILE"; then \
        sed -i 's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/' "$DEGRADATIONS_FILE"; \
    fi || true

# Pre-download model weights
RUN WEIGHTS_DIR=$(python3 -c "import site; print(site.getsitepackages()[0])")/weights && \
    mkdir -p "$WEIGHTS_DIR" && \
    curl -sL https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth \
    -o "$WEIGHTS_DIR/RealESRGAN_x4plus.pth"

# Static ffmpeg 7.x
RUN curl -sL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz | tar xJ -C /tmp/ && \
    cp /tmp/ffmpeg-*-amd64-static/ffmpeg /usr/local/bin/ffmpeg && \
    cp /tmp/ffmpeg-*-amd64-static/ffprobe /usr/local/bin/ffprobe && \
    rm -rf /tmp/ffmpeg-*

# Deno (needed by yt-dlp for YouTube JS challenge solving)
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh

# Build Rust binaries (status_server, gpu_scheduler, enhance, frame_gap_check, rebalance_calc, youtube_upload)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:$PATH"
RUN git clone --depth 1 https://github.com/zdavatz/old2new.git /tmp/old2new && \
    cd /tmp/old2new/status_server_rs && cargo build --release && \
    cp target/release/status_server /usr/local/bin/ && cp target/release/status_server /root/ && \
    cp target/release/gpu_scheduler /usr/local/bin/ && cp target/release/gpu_scheduler /root/ && \
    cp target/release/enhance /usr/local/bin/ && cp target/release/enhance /root/ && \
    cp target/release/frame_gap_check /usr/local/bin/ && cp target/release/frame_gap_check /root/ && \
    cp target/release/rebalance_calc /usr/local/bin/ && cp target/release/rebalance_calc /root/ && \
    cd /tmp/old2new/youtube_upload_rs && cargo build --release && \
    cp target/release/youtube_upload /usr/local/bin/ && cp target/release/youtube_upload /root/ && \
    chmod +x /root/status_server /root/gpu_scheduler /root/enhance /root/frame_gap_check /root/rebalance_calc /root/youtube_upload && \
    rm -rf /tmp/old2new /root/.cargo/registry /root/.cargo/git && \
    rustup self uninstall -y 2>/dev/null || true

# Export TorchScript model for future Rust upscaler
RUN python3 -c "\
from basicsr.archs.rrdbnet_arch import RRDBNet; import torch, site, os; \
model = RRDBNet(num_in_ch=3, num_out_ch=3, num_feat=64, num_block=23, num_grow_ch=32, scale=4); \
wp = os.path.join(site.getsitepackages()[0], 'weights', 'RealESRGAN_x4plus.pth'); \
ln = torch.load(wp, map_location='cpu', weights_only=False); \
model.load_state_dict(ln.get('params_ema', ln.get('params', ln)), strict=True); model.eval(); \
traced = torch.jit.trace(model, torch.randn(1, 3, 64, 64)); traced.save('/root/RealESRGAN_x4plus.pt'); \
print(f'TorchScript model: {os.path.getsize(\"/root/RealESRGAN_x4plus.pt\") / 1024 / 1024:.1f} MB')"

# Verify
RUN python3 -c "import torch; print(f'PyTorch: {torch.__version__}')"
RUN python3 -c "import cv2; print(f'OpenCV: {cv2.__version__}')"
RUN python3 -c "from basicsr.archs.rrdbnet_arch import RRDBNet; print('BasicSR: OK')"
RUN /root/status_server --version 2>&1 || true && echo "Rust binaries: OK"
RUN echo "ALL OK — slim image with Rust binaries"

WORKDIR /root
CMD ["bash"]
